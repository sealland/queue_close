PORT=3032
HOST=0.0.0.0

# SQL Server
DB_SERVER=localhost
DB_NAME=AI_LOCAL_PP
DB_PORT=1433

# Auth: windows | sql
DB_AUTH_TYPE=windows

# SQL auth (production)
DB_USER=
DB_PASSWORD=

DB_TRUST_SERVER_CERTIFICATE=true
DB_ENCRYPT=true

# Queue filters (changeable)
DB_SHIP_POINT=P1
DB_QUEUE_PREFIX=9

# HR SQL Server (ZHR_EMPLOYEE) - separate connection
HR_DB_SERVER=
HR_DB_NAME=
HR_DB_AUTH_TYPE=sql
HR_DB_USER=
HR_DB_PASSWORD=
HR_DB_TRUST_SERVER_CERTIFICATE=true
HR_DB_ENCRYPT=false
